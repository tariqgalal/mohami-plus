# =============================================================
# محامي بلس — Environment Variables
# انسخ هذا الملف إلى .env.local وعبّئ القيم
# =============================================================

# ---------- المطلوبة فعلياً للتشغيل ----------

# قاعدة بيانات Postgres (Supabase recommended)
# pooler للاتصال العادي
DATABASE_URL="postgresql://user:password@host:5432/postgres?pgbouncer=true"
# اتصال مباشر (يُستخدم في migrations فقط)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Auth.js v5 — سرّ توقيع الـ JWT
# ولّده بـ:  openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# عنوان الاستضافة الكامل (مع البروتوكول)
# على Vercel يُحدَّد تلقائياً، أما على غيرها فضعه يدوياً
NEXTAUTH_URL="http://localhost:3000"

# عرض اسم التطبيق + الـ URL المنشور (يظهر في الواجهة)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="محامي بلس"

# سرّ تفويض استدعاء /api/cron/check-overdue-invoices
# يجب أن يطابق Authorization: Bearer <CRON_SECRET>
# Vercel Cron يستخدم رأس x-vercel-cron بدلاً منه
CRON_SECRET="replace-with-openssl-rand-base64-32"


# ---------- تخزين الملفات (Supabase Storage — مستخدَم فعلياً) ----------
# رفع وتحميل المستندات يمر عبر الـ API ويستخدم Supabase Storage.
# بدون هذه المتغيرات في الإنتاج يظهر للمستخدم: "خدمة رفع الملفات غير متاحة حالياً".
# احصل عليها من: Supabase Dashboard → Project Settings → API
# وشغّل مرّة واحدة: supabase/storage-setup.sql لإنشاء الـ bucket (private).

# عنوان مشروع Supabase (مثال: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=""
# المفتاح العام (anon) — آمن للواجهة الأمامية
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# مفتاح service_role — سرّي، يُستخدم من السيرفر فقط للرفع/التحميل الموقَّع
# ⚠️ لا تعرّضه للواجهة الأمامية إطلاقاً
SUPABASE_SERVICE_ROLE_KEY=""


# ---------- مستقبلية (مذكورة في الخطة، لم تُستخدم في الكود بعد) ----------

# البريد (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@mohamiplus.sa"

# =============================================================
# الدفع (Moyasar — بوابة سعودية)
# المرحلة الحالية: Test Mode فقط. ممنوع استخدام مفاتيح الإنتاج هنا.
# احصل عليها من: https://dashboard.moyasar.com → API Keys
# =============================================================

# المفتاح العام (Publishable) — يُستخدم في الواجهة الأمامية (Moyasar.js)
# يبدأ في وضع الاختبار بـ pk_test_
MOYASAR_PUBLISHABLE_KEY_TEST=""

# المفتاح السرّي (Secret) — يُستخدم من السيرفر فقط
# للتحقق من المدفوعات وشحن التوكنات
# يبدأ في وضع الاختبار بـ sk_test_
MOYASAR_SECRET_KEY_TEST=""

# الـ shared_secret اللي خزّنته في إعدادات الـ Webhook في لوحة Moyasar
# Moyasar بترسله في كل webhook كحقل secret_token داخل الـ JSON body
# المستقبِل (نحن) يقارنه بهذه القيمة (مقارنة timing-safe)
MOYASAR_WEBHOOK_SECRET=""

# تفعيل الخصم التلقائي (Tokenization). اتركها "false" إلى أن تفعّل Moyasar
# ميزة الـ Tokenization على حسابك. لما تكون "false" خيار التجديد التلقائي
# يظهر للمستخدم كـ "قريباً" والمسار اليدوي وحده يعمل.
MOYASAR_TOKENIZATION_ENABLED="false"
